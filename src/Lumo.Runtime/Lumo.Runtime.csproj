<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lumo.Runtime</RootNamespace>
    <AssemblyName>Lumo.Runtime</AssemblyName>
    <ApplicationIcon>..\Lumo.Editor\Assets\lumo_icon.ico</ApplicationIcon>
    <NoWarn>NU1903</NoWarn>
    <AvaloniaUseDownoadedNativeAssets>true</AvaloniaUseDownoadedNativeAssets>
    <AvaloniaBuildServicesDisabled>true</AvaloniaBuildServicesDisabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumo.Engine\Lumo.Engine.csproj" />
    <ProjectReference Include="..\Lumo.Plugins\Lumo.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lumo logo for the loading screen (shared with the editor's assets). -->
    <EmbeddedResource Include="..\Lumo.Editor\Assets\lumo_logo_transparent.png"
                      LogicalName="Lumo.Runtime.lumo_logo_transparent.png" />
    <EmbeddedResource Include="..\Lumo.Editor\Assets\lumo_icon.png"
                      LogicalName="Lumo.Runtime.lumo_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
  </ItemGroup>

</Project>
