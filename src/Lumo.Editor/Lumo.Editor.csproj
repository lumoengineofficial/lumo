<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lumo.Editor</RootNamespace>
    <AssemblyName>Lumo.Editor</AssemblyName>
    <ApplicationIcon>Assets\lumo_icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>NU1903</NoWarn>
    <AvaloniaUseDownoadedNativeAssets>true</AvaloniaUseDownoadedNativeAssets>
    <AvaloniaBuildServicesDisabled>true</AvaloniaBuildServicesDisabled>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumo.Engine\Lumo.Engine.csproj" />
    <ProjectReference Include="..\Lumo.Runtime\Lumo.Runtime.csproj" />
    <ProjectReference Include="..\Lumo.Plugins\Lumo.Plugins.csproj" />
    <!-- Build-order only: the sample plugin deploys itself to Plugins/. -->
    <ProjectReference Include="..\Lumo.SamplePlugin\Lumo.SamplePlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Lumo.TerrainPlugin\Lumo.TerrainPlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\lumo_logo_transparent.png" />
    <EmbeddedResource Include="Assets\lumo_icon.png" />
    <EmbeddedResource Include="Assets\lumo_splash.png" />
  </ItemGroup>

</Project>
